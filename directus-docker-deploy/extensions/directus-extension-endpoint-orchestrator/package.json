{
  "name": "directus-extension-endpoint-orchestrator",
  "type": "module",
  "version": "2.1.0",
  "description": "Agent orchestration endpoint with circuit breaker, retry logic, and workflow record persistence",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-endpoint",
    "orchestrator"
  ],
  "icon": "hub",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
