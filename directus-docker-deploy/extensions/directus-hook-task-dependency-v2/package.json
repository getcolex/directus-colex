{
  "name": "directus-hook-task-dependency-v2",
  "version": "1.0.0",
  "type": "module",
  "description": "Task dependency hook v2 - supports multiple dependencies via depends_on JSON array",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-hook"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.2"
  }
}
