{
	"name": "colex-button-system-bundle",
	"type": "module",
	"version": "1.0.0",
	"description": "Complete button system with configurable actions, webhooks, dependencies, context sync, and review workflows",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"colex"
	],
	"icon": "extension",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "display",
				"name": "configurable-button",
				"source": "src/configurable-button/index.ts"
			},
			{
				"type": "hook",
				"name": "populate-button-context",
				"source": "src/populate-button-context/index.js"
			},
			{
				"type": "hook",
				"name": "task-dependency-v2",
				"source": "src/task-dependency-v2/index.js"
			},
			{
				"type": "endpoint",
				"name": "webhook-proxy",
				"source": "src/webhook-proxy/index.js"
			},
			{
				"type": "module",
				"name": "review-module",
				"source": "src/review-module/index.ts"
			}
		],
		"host": "^11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "npm pack",
		"export": "npm pack && tar -xzf colex-button-system-bundle-1.0.0.tgz && zip -r colex-button-system-bundle-1.0.0.zip package && rm -rf package colex-button-system-bundle-1.0.0.tgz"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^12.0.2",
		"@vitejs/plugin-vue": "^5.0.4",
		"@vue/test-utils": "^2.4.4",
		"happy-dom": "^13.3.8",
		"typescript": "^5.5.4",
		"vitest": "^1.3.1",
		"vue": "^3.4.38"
	}
}
