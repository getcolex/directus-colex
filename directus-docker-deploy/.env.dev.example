# Directus Local Development Environment
# Copy this file to .env for local development
# DO NOT commit .env file to git

####################################
# Database Configuration
####################################
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=directus
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

####################################
# Admin Account (Dev Defaults)
####################################
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=d1r3ctu5

####################################
# Security Keys (CHANGE THESE!)
####################################
# Generate random 32-char key: openssl rand -base64 32
KEY=dev-key-replace-in-production-32chars

# Generate random 64-char secret: openssl rand -base64 64
SECRET=dev-secret-replace-in-production-with-64-character-random-string

####################################
# Application Settings
####################################
PUBLIC_URL=http://localhost:8055
WEBHOOK_SECRET=dev-webhook-secret
DISABLE_TELEMETRY=true

####################################
# API Keys (Optional)
####################################
# OpenRouter API for Intelligence Chat
OPENROUTER_API_KEY=

# Exa API for Lead Gen
EXA_API_KEY=

####################################
# Development Notes
####################################
# - Extensions auto-reload is enabled by default
# - Caching is disabled for easier development
# - Log level is set to debug
# - No SSL required for local database
# - Database runs on localhost:5432
# - Directus runs on localhost:8055
