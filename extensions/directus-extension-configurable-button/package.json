{
  "name": "directus-extension-configurable-button",
  "version": "1.4.6",
  "description": "State-driven action buttons with dynamic visibility and contextual filtering for Directus",
  "icon": "touch_app",
  "type": "module",
  "author": "Your Name",
  "license": "MIT",
  "directus:extension": {
    "type": "display",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "test:coverage": "c8 node --test tests/*.test.mjs",
    "clean": "rm -rf dist node_modules",
    "prepare": "npm run build"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-display",
    "directus-custom-display",
    "button",
    "action-button",
    "configurable",
    "workflow",
    "state-driven",
    "visibility-conditions",
    "dynamic-buttons",
    "contextual"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "CAPABILITIES.md",
    "IMPLEMENTATION.md",
    "EXPORT_GUIDE.md",
    "QUICK_START.md",
    "tests"
  ],
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.0",
    "chromedriver": "^142.0.3",
    "selenium-webdriver": "^4.38.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}
